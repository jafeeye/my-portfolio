        <description>&lt;nav class=&#34;article-toc&#34;&gt;
    &lt;nav id=&#34;TableOfContents&#34;&gt;
  &lt;ol&gt;
    &lt;li&gt;&lt;a href=&#34;#iventoy-lxc-pxe-部屬&#34;&gt;iVentoy LXC PXE 部屬&lt;/a&gt;&lt;/li&gt;
    &lt;li&gt;&lt;a href=&#34;#netbootxyz&#34;&gt;netboot.xyz&lt;/a&gt;&lt;/li&gt;
  &lt;/ol&gt;
